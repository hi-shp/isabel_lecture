[Unit]
Description=Vessel sensors and actuators (dashboard managed separately)
Conflicts=isabel-sensor-check.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/ubuntu
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/ros2_ws/install/setup.bash && source /home/ubuntu/uros_ws/install/setup.bash && source /home/ubuntu/water_survey_ws/current_release/install/setup.bash && exec ros2 launch mechaship_bringup mechaship_bringup.launch.py survey_dashboard:=false mechaship_imu_parameter:=/home/ubuntu/water_survey_ws/current_release/install/water_survey/share/water_survey/config/mechaship_imu.yaml'
KillSignal=SIGINT
TimeoutStopSec=25
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
