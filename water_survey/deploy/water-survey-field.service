[Unit]
Description=Water survey field dashboard
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target
Conflicts=water-survey-indoor.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/ros2_ws/install/setup.bash && source /home/ubuntu/uros_ws/install/setup.bash && source /home/ubuntu/water_survey_ws/install/setup.bash && exec ros2 launch water_survey field.launch.py'
KillSignal=SIGINT
TimeoutStopSec=25
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
