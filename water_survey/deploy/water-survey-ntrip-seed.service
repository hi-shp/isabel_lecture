[Unit]
Description=Selected GPS position seed for NTRIP VRS
After=water-survey-indoor.service

[Service]
Type=simple
User=ubuntu
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/water_survey_ws/current_release/install/setup.bash && exec python3 -m water_survey.ntrip_seed'
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
